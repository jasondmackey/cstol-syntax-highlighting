%YAML 1.2
---
# CSTOL syntax for bat / Sublime Text. Mirrors cstol-syntax/syntaxes/cstol.tmLanguage.json
# and emits the same scopes, so the CSTOL 5 .tmTheme colors it identically.
name: CSTOL
scope: source.cstol
file_extensions: [prc]

contexts:
  main:
    - match: '^\s*[a-zA-Z_][a-zA-Z0-9_]*\s*:'
      scope: entity.name.label.cstol
    - match: '"'
      push: string
    - match: ';.*$'
      scope: comment.line.semicolon.cstol
    - match: '\b\d+:\d+(:\d+)?(\.\d+)?\b'
      scope: constant.numeric.time.cstol
    - match: '\b0[xX][0-9a-fA-F]+\b'
      scope: constant.numeric.hex.cstol
    - match: '\b\d*\.\d+([eE][+-]?\d+)?\b'
      scope: constant.numeric.float.cstol
    - match: '\b\d+([eE][+-]?\d+)?\b'
      scope: constant.numeric.integer.cstol
    - match: '\$\$ERROR\b'
      scope: variable.parameter.error.cstol
    - match: '\$\$[a-zA-Z_][a-zA-Z0-9_]*'
      scope: variable.parameter.special.cstol
    - match: '\$[a-zA-Z_][a-zA-Z0-9_]*'
      scope: variable.parameter.cstol
    - match: '(?i)\bwait\b'
      scope: keyword.control.wait.cstol
    - match: '(?i)\bgoto\b'
      scope: keyword.control.flow.goto.cstol
    - match: '(?i)\breturn\b'
      scope: keyword.control.flow.cstol
    - match: '(?i)\bstart\b'
      scope: keyword.control.start.cstol
    - match: '(?i)\b(loop|end\s+loop)\b'
      scope: keyword.control.loop.cstol
    - match: '(?i)\b(if|elseif|else|endif|end\s+if)\b'
      scope: keyword.control.conditional.cstol
    - match: '(?i)\b(check|let|set|cmd|write|proc|endproc|end\s+proc|begin|ask|declare)\b'
      scope: keyword.control.command.cstol
    - match: '(?i)\b(vs|with|and|or|not|until|for|dn)\b'
      scope: keyword.operator.word.cstol
    - match: '(/=|<=|>=|=|<|>)'
      scope: keyword.operator.comparison.cstol
    - match: '(\+|-|\*|/|%|&|\||!)'
      scope: keyword.operator.cstol
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.cstol
    - match: '\b[A-Z][A-Z0-9_]*\b'
      scope: variable.other.constant.cstol

  string:
    - meta_scope: string.quoted.double.cstol
    - match: '"|$'
      pop: true
