{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["(", ")"],
    ["[", "]"],
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "wordPattern": "\\${0,2}[a-zA-Z_][a-zA-Z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?i:(if|elseif|else|loop|proc)\\b)",
    "decreaseIndentPattern": "^\\s*(?i:(elseif|else|endif|end\\s+if|end\\s+loop|endproc|end\\s+proc)\\b)"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(?i:(if|loop|proc)\\b)",
      "end": "^\\s*(?i:(endif|end\\s+if|end\\s+loop|endproc|end\\s+proc)\\b)"
    }
  }
}
