{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "cstol",
  "word": "identifier",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_line"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_last_line"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "_last_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "label"
            },
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "_token"
              }
            }
          ]
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r?\\n"
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "time"
        },
        {
          "type": "SYMBOL",
          "name": "special_variable"
        },
        {
          "type": "SYMBOL",
          "name": "variable"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_wait"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_goto"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_flow"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_start"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_loop"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_conditional"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_command"
        },
        {
          "type": "SYMBOL",
          "name": "keyword_operator"
        },
        {
          "type": "SYMBOL",
          "name": "operator"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "STRING",
          "value": ","
        },
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": ";"
          },
          {
            "type": "PATTERN",
            "value": "[^\\r\\n]*"
          }
        ]
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "PATTERN",
            "value": "[^\"\\r\\n]*"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "time": {
      "type": "PATTERN",
      "value": "\\d+:\\d+(:\\d+)?(\\.\\d+)?"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F]+"
          },
          {
            "type": "PATTERN",
            "value": "\\d*\\.\\d+([eE][+-]?\\d+)?"
          },
          {
            "type": "PATTERN",
            "value": "\\d+([eE][+-]?\\d+)?"
          }
        ]
      }
    },
    "variable": {
      "type": "PATTERN",
      "value": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "special_variable": {
      "type": "PATTERN",
      "value": "\\$\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },
    "label": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*[ \\t]*:"
    },
    "keyword_wait": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[wW][aA][iI][tT]"
      }
    },
    "keyword_goto": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[gG][oO][tT][oO]"
      }
    },
    "keyword_flow": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[rR][eE][tT][uU][rR][nN]"
      }
    },
    "keyword_start": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[sS][tT][aA][rR][tT]"
      }
    },
    "keyword_loop": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[lL][oO][oO][pP]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][nN][dD][ \\t]+[lL][oO][oO][pP]"
          }
        ]
      }
    },
    "keyword_conditional": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[iI][fF]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][lL][sS][eE][iI][fF]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][lL][sS][eE]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][nN][dD][iI][fF]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][nN][dD][ \\t]+[iI][fF]"
          }
        ]
      }
    },
    "keyword_command": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[cC][hH][eE][cC][kK]"
          },
          {
            "type": "PATTERN",
            "value": "[lL][eE][tT]"
          },
          {
            "type": "PATTERN",
            "value": "[sS][eE][tT]"
          },
          {
            "type": "PATTERN",
            "value": "[cC][mM][dD]"
          },
          {
            "type": "PATTERN",
            "value": "[wW][rR][iI][tT][eE]"
          },
          {
            "type": "PATTERN",
            "value": "[pP][rR][oO][cC]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][nN][dD][pP][rR][oO][cC]"
          },
          {
            "type": "PATTERN",
            "value": "[eE][nN][dD][ \\t]+[pP][rR][oO][cC]"
          },
          {
            "type": "PATTERN",
            "value": "[bB][eE][gG][iI][nN]"
          },
          {
            "type": "PATTERN",
            "value": "[aA][sS][kK]"
          },
          {
            "type": "PATTERN",
            "value": "[dD][eE][cC][lL][aA][rR][eE]"
          }
        ]
      }
    },
    "keyword_operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "PATTERN",
            "value": "[vV][sS]"
          },
          {
            "type": "PATTERN",
            "value": "[wW][iI][tT][hH]"
          },
          {
            "type": "PATTERN",
            "value": "[aA][nN][dD]"
          },
          {
            "type": "PATTERN",
            "value": "[oO][rR]"
          },
          {
            "type": "PATTERN",
            "value": "[nN][oO][tT]"
          },
          {
            "type": "PATTERN",
            "value": "[uU][nN][tT][iI][lL]"
          },
          {
            "type": "PATTERN",
            "value": "[fF][oO][rR]"
          },
          {
            "type": "PATTERN",
            "value": "[dD][nN]"
          }
        ]
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "/="
          },
          {
            "type": "STRING",
            "value": "<="
          },
          {
            "type": "STRING",
            "value": ">="
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "STRING",
            "value": ">"
          },
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "STRING",
            "value": "%"
          },
          {
            "type": "STRING",
            "value": "&"
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "STRING",
            "value": "!"
          }
        ]
      }
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\f]+"
    },
    {
      "type": "PATTERN",
      "value": "\\\\\\r?\\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
